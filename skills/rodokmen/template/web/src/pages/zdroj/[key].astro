---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import { records, recordList } from '../../lib/data.js';
import domyData from '../../data/domy.json';

export function getStaticPaths() {
  return recordList.map((r) => ({ params: { key: r.key } }));
}
const r = records[Astro.params.key];
const domById = Object.fromEntries(domyData.domy.map((d) => [d.id, d]));
const recDomy = (domyData.zapisy[r.key] || []).map((id) => domById[id]).filter(Boolean);
---
<Base title={r.title} wide>
  <p class="crumbs"><a href="/zapisy/">Zápisy z matrik</a> · <span class="kind">{r.kindName}</span></p>
  <h1>{r.title}</h1>
  <p class="lead">{r.summary}</p>
  <div class="table-box"><table>
    <tbody>
      <tr><th>Datum</th><td>{r.date}</td></tr>
      <tr><th>Archiv</th><td>{r.archive}</td></tr>
      <tr><th>Svazek</th><td>{r.volume}</td></tr>
      <tr><th>Snímek</th><td>{r.scan}{r.url && <> – <a href={r.url} target="_blank" rel="noopener">otevřít na portálu {r.portal}</a></>}</td></tr>
      {recDomy.length > 0 && <tr><th>Domy</th><td>{recDomy.map((d, i) => <>{i > 0 && ', '}<a href={`/domy/#${d.id}`}>{d.obec} čp. {d.cp}</a></>)}</td></tr>}
      {r.people.length > 0 && <tr><th>Týká se</th><td>{r.people.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} /></>)}</td></tr>}
    </tbody>
  </table></div>
  {r.img && (
    <p style="margin-top:1rem">
      <a href={r.full ? `/zdroje/${r.key}.jpg` : `/img/${r.key}.jpg`} target="_blank" rel="noopener"><span class="hl-wrap" style="border:1px solid var(--line);border-radius:8px"><img src={`/img/${r.key}.jpg`} alt={`Výřez zápisu: ${r.title}`} />{r.boxes.map(([x0, y0, x1, y1]) => <span class="hl" style={`left:${x0 * 100}%;top:${y0 * 100}%;width:${(x1 - x0) * 100}%;height:${(y1 - y0) * 100}%`}></span>)}</span></a>
      <br /><span class="small muted">{r.boxes.length ? 'Červeně je označené místo, ze kterého čteme. ' : ''}{r.full ? 'Kliknutím otevřete výřez v plném rozlišení.' : ''}</span>
    </p>
  )}
  {r.orig && (
    <div class="transcript">
      <div class="tr-grid">
        <div><h2>Přepis originálu</h2><p class="tr-orig">{r.orig}</p></div>
        <div><h2>Překlad</h2><p class="tr-cs">{r.cs}</p></div>
      </div>
      <p class="small muted">Nejistá čtení jsou označená (?), nečitelná místa […]. Přepis si můžete ověřit na výřezu výše.</p>
    </div>
  )}
</Base>
