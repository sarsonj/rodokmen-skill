---
import Base from '../layouts/Base.astro';
import fan from '../generated/fan.svg?raw';
import { people, lines, href } from '../lib/data.js';
// data pro vějíř kreslený v prohlížeči (vějíř od libovolné osoby): absolutní číslo → jméno, roky, stav, odkaz
const fanData = Object.fromEntries(Object.values(people).filter((p) => p.k).map((p) => [p.k, { name: p.name, years: p.years || '', st: p.st, href: href.person(p.slug), slug: p.slug }]));
const lineNames = Object.fromEntries(Object.values(lines).map((l) => [l.k, l.name]));
const names = [...new Set(Object.values(people).filter((p) => p.k > 1).map((p) => p.name))].sort((a, b) => a.localeCompare(b, 'cs'));
---
<Base title="Vějíř předků" full>
  <div class="fan-bar">
    <strong>Vějíř předků</strong>
    <form class="fan-search" autocomplete="off">
      <input list="fan-names" placeholder="Najít předka…" aria-label="Najít předka" />
      <datalist id="fan-names">{names.map((n) => <option value={n} />)}</datalist>
      <button type="submit">Najít</button>
    </form>
    <span class="fan-btns">
      <button type="button" data-z="1.5" aria-label="Přiblížit">+</button>
      <button type="button" data-z="0.667" aria-label="Oddálit">−</button>
      <button type="button" data-z="0">Celý</button>
    </span>
    <span class="fan-od" hidden>Vějíř od: <strong></strong> <button type="button" class="fan-home">← zpět na celý rodokmen</button></span>
    <span class="small muted fan-hint">Kolečkem myši přibližujte, tažením posouvejte, klepnutím otevřete stránku osoby; podržením myši (na mobilu klepnutím) nabídku s vějířem od dané osoby.</span>
  </div>
  <div class="fan-menu" hidden><strong></strong><a class="fan-menu-page" href="#">Stránka osoby →</a><button type="button" class="fan-menu-fan">Vějíř od této osoby</button></div>
  <script is:inline type="application/json" id="fan-data" set:html={JSON.stringify({ people: fanData, lineNames })}></script>
  <div class="fan-stage" set:html={fan} />

  <script>
    import { renderFan } from '../lib/fan.js';
    const stage = document.querySelector<HTMLElement>('.fan-stage')!;
    let svg = stage.querySelector('svg')!;
    const staticFan = stage.innerHTML;
    // jméno z <title> přesunout do data-t / aria-label a <title> smazat – jinak prohlížeč ukazuje
    // vlastní bublinu navíc k naší nabídce
    const untitle = () => svg.querySelectorAll<SVGAElement>('.fan-links a').forEach((a) => {
      const t = a.querySelector('title');
      if (!t) return;
      a.dataset.t = t.textContent ?? '';
      a.setAttribute('aria-label', a.dataset.t);
      t.remove();
    });
    untitle();
    const full = svg.viewBox.baseVal;
    let home = { x: full.x, y: full.y, w: full.width, h: full.height };
    let vb = { ...home };
    const data = JSON.parse(document.getElementById('fan-data')!.textContent!);
    const bySlug: Record<string, number> = Object.fromEntries(Object.entries(data.people).map(([k, p]: [string, any]) => [p.slug, Number(k)]));
    const odBox = document.querySelector<HTMLElement>('.fan-od')!;
    /** Vějíř od osoby s číslem k (1 = celý rodokmen = předgenerovaný vějíř). */
    const showFrom = (k: number, push = true) => {
      stage.innerHTML = k === 1 ? staticFan : renderFan(data.people, k, data.lineNames);
      svg = stage.querySelector('svg')!;
      untitle();
      const v = svg.viewBox.baseVal;
      home = { x: v.x, y: v.y, w: v.width, h: v.height };
      vb = { ...home }; apply();
      odBox.hidden = k === 1;
      if (k !== 1) odBox.querySelector('strong')!.textContent = `${data.people[k].name} ${data.people[k].years}`;
      if (push) {
        const url = new URL(location.href);
        if (k === 1) url.searchParams.delete('od'); else url.searchParams.set('od', data.people[k].slug);
        history.pushState({ k }, '', url);
      }
    };
    window.addEventListener('popstate', (e) => showFrom(e.state?.k ?? 1, false));
    document.querySelector('.fan-home')!.addEventListener('click', () => showFrom(1));

    // malá nabídka nad polem: stránka osoby, nebo vějíř od ní.
    // Myš (počítač): nabídka po chvilce podržení nad polem, klik vede rovnou na stránku osoby.
    // Dotyk (mobil): klepnutí otevře nabídku.
    const menu = document.querySelector<HTMLElement>('.fan-menu')!;
    const hover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const kOf = (a: Element) => Number((a as SVGAElement).dataset.k || 0) || bySlug[(a.getAttribute('href') || '').split('/osoba/')[1]?.replace(/\/$/, '')] || 0;
    let menuFor: Element | null = null, openT = 0, closeT = 0;
    const openMenu = (a: Element, x: number, y: number) => {
      const k = kOf(a);
      menuFor = a;
      menu.querySelector('strong')!.textContent = (a as SVGAElement).dataset.t ?? '';
      (menu.querySelector('.fan-menu-page') as HTMLAnchorElement).href = a.getAttribute('href')!;
      const fb = menu.querySelector<HTMLButtonElement>('.fan-menu-fan')!;
      fb.hidden = !k || (data.people[2 * k] === undefined && data.people[2 * k + 1] === undefined);
      fb.onclick = () => { closeMenu(); showFrom(k); };
      menu.hidden = false;
      menu.style.left = Math.min(x + 12, innerWidth - menu.offsetWidth - 8) + 'px';
      menu.style.top = Math.min(y + 12, innerHeight - menu.offsetHeight - 8) + 'px';
    };
    const closeMenu = () => { menu.hidden = true; menuFor = null; };
    if (hover) {
      // Nabídka se otevře, až když kurzor chvíli STOJÍ (HOVER_MS); pohyb o víc než ~6 px odpočet restartuje.
      // Pozice nabídky je z posledního pohybu myši. Vjezd do nabídky zapomene jméno, přes které kurzor cestou přejel.
      const HOVER_MS = 700;
      let cur: Element | null = null, px = 0, py = 0, ax = 0, ay = 0;
      const arm = () => {
        clearTimeout(openT);
        ax = px; ay = py;
        if (!cur || cur === menuFor) return;
        const a = cur;
        openT = window.setTimeout(() => { if (cur === a && !pts.size && !menu.matches(':hover')) openMenu(a, px, py); }, HOVER_MS);
      };
      stage.addEventListener('pointerover', (e) => {
        cur = (e.target as Element).closest?.('.fan-links a') ?? null;
        px = e.clientX; py = e.clientY;
        if (cur) clearTimeout(closeT);
        arm();
      });
      stage.addEventListener('pointermove', (e) => {
        px = e.clientX; py = e.clientY;
        if (cur && cur !== menuFor && Math.hypot(px - ax, py - ay) > 6) arm();
      });
      const leave = () => { cur = null; clearTimeout(openT); clearTimeout(closeT); closeT = window.setTimeout(closeMenu, 350); };
      const intoMenu = () => { cur = null; clearTimeout(openT); clearTimeout(closeT); };
      stage.addEventListener('pointerout', (e) => { if (menu.contains(e.relatedTarget as Node)) intoMenu(); else leave(); });
      menu.addEventListener('pointerenter', intoMenu);
      menu.addEventListener('pointerleave', (e) => { if (!(e.relatedTarget as Element)?.closest?.('.fan-links a')) leave(); });
      stage.addEventListener('wheel', () => { clearTimeout(openT); closeMenu(); });
    } else {
      stage.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.('.fan-links a');
        if (!a || moved > 4) return;
        e.preventDefault();
        openMenu(a, e.clientX, e.clientY);
      });
      document.addEventListener('pointerdown', (e) => { if (!menu.hidden && !menu.contains(e.target as Node) && !(e.target as Element).closest?.('.fan-links a')) closeMenu(); });
    }
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
    const apply = () => svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
    const toSvg = (cx: number, cy: number) => {
      const r = svg.getBoundingClientRect();
      const s = Math.max(vb.w / r.width, vb.h / r.height);
      const ox = (r.width * s - vb.w) / 2, oy = (r.height * s - vb.h) / 2;
      return { x: vb.x - ox + (cx - r.left) * s, y: vb.y - oy + (cy - r.top) * s, s };
    };
    const zoomAt = (f: number, cx?: number, cy?: number) => {
      const r = svg.getBoundingClientRect();
      const p = toSvg(cx ?? r.left + r.width / 2, cy ?? r.top + r.height / 2);
      const w = Math.min(home.w * 1.2, Math.max(home.w / 40, vb.w / f));
      const k = w / vb.w;
      vb = { x: p.x - (p.x - vb.x) * k, y: p.y - (p.y - vb.y) * k, w, h: vb.h * k };
      apply();
    };
    // Zoom úměrný velikosti posunu: kolečko myši (deltaY ~100) dá krok ~1,25×, touchpad (spousta malých událostí)
    // jemný plynulý zoom; štípnutí na touchpadu (ctrlKey) je citlivější. (#165)
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      let d = e.deltaY;
      if (e.deltaMode === 1) d *= 33; else if (e.deltaMode === 2) d *= 300;   // řádky / stránky → px
      d = Math.max(-120, Math.min(120, d));
      zoomAt(Math.exp(-d * (e.ctrlKey ? 0.012 : 0.0022)), e.clientX, e.clientY);
    }, { passive: false });

    // drag to pan (mouse + one finger), pinch to zoom (two fingers)
    const pts = new Map<number, { x: number; y: number }>();
    let moved = 0, pinch = 0;
    stage.addEventListener('pointerdown', (e) => { pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); moved = 0; });
    stage.addEventListener('pointermove', (e) => {
      const prev = pts.get(e.pointerId);
      if (!prev) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 2) {
        const [a, b] = [...pts.values()];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinch) zoomAt(d / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2);
        pinch = d; moved += 10;
        return;
      }
      const { s } = toSvg(e.clientX, e.clientY);
      const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
      moved += Math.abs(dx) + Math.abs(dy);
      if (moved > 4) { stage.setPointerCapture(e.pointerId); vb.x -= dx * s; vb.y -= dy * s; apply(); }
    });
    const up = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) pinch = 0; };
    stage.addEventListener('pointerup', up);
    stage.addEventListener('pointercancel', up);
    stage.addEventListener('click', (e) => { if (moved > 4) { e.preventDefault(); e.stopPropagation(); } }, true);
    const start = new URL(location.href).searchParams.get('od');
    if (start && bySlug[start] && bySlug[start] !== 1) { showFrom(bySlug[start], false); history.replaceState({ k: bySlug[start] }, ''); }

    document.querySelectorAll<HTMLButtonElement>('.fan-btns button').forEach((b) =>
      b.addEventListener('click', () => { const z = Number(b.dataset.z); if (z) zoomAt(z); else { vb = { ...home }; apply(); } })
    );

    // search: zoom to the ancestor's segment and highlight it
    const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    document.querySelector('.fan-search')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = norm((e.currentTarget as HTMLFormElement).querySelector('input')!.value.trim());
      if (!q) return;
      svg.querySelectorAll('.fan-links a.hit').forEach((a) => a.classList.remove('hit'));
      const hits = [...svg.querySelectorAll<SVGAElement>('.fan-links a')].filter((a) => norm((a as SVGAElement).dataset.t ?? '').includes(q));
      if (!hits.length) return;
      hits.forEach((a) => a.classList.add('hit'));
      const bb = (hits[0].lastElementChild as SVGGraphicsElement).getBBox();
      const w = Math.max(bb.width, bb.height) * 7;
      vb = { x: bb.x + bb.width / 2 - w / 2, y: bb.y + bb.height / 2 - w / 2, w, h: w };
      apply();
    });
  </script>
  <style is:global>
    .fan-menu { position: fixed; z-index: 50; background: #fff; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 6px 24px rgba(0,0,0,.18);
      padding: .6rem .8rem; display: flex; flex-direction: column; gap: .35rem; max-width: 20rem; font-size: .95rem; }
    .fan-menu[hidden] { display: none; }
    .fan-menu strong { color: #3b2e22; }
    .fan-menu button { font: inherit; text-align: left; border: 0; background: none; color: var(--accent, #8a5a2b); padding: 0; cursor: pointer; text-decoration: underline; }
    .fan-menu button[hidden] { display: none; }
    .fan-od button { font: inherit; border: 1px solid var(--line); background: #fff; border-radius: 6px; padding: .1rem .5rem; cursor: pointer; }
  </style>
</Base>
