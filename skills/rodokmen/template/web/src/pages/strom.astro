    rodSel.addEventListener('change', () => setRod(rodSel.value));
    // switch the view; the focus view is laid out around `id` (the current selection)
    function setMode(m: Mode, id = current(), animate = false) {
      const from = P(id);
      mode = m;
      L = m === 'focus' ? focusLayout(nodes[id] ? id : data.root, depthUp, depthDown) : LAY[m];
      try { localStorage.setItem('strom-mode', m); } catch { /* storage blocked */ }
