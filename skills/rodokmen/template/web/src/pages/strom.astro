      rodSel.value = line;
      if (mode === 'focus' && line) setMode('full'); else draw();
      // keep the selection when it belongs to the line, otherwise go back to the children (without a hash event)
      const cur = inRod && !inRod.has(current()) ? data.root : current();
      if (cur !== current()) history.replaceState(null, '', '#' + encodeURIComponent(cur));
