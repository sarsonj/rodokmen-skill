---
// Strom: the whole family graph (ancestors and side relatives from SIDE) as cards with zoom and pan,
// a panel on the left with everything we know about the selected person. Selection lives in the URL hash.
// Data from scripts/strom.py, layout of the precomputed views (Graphviz dot, at build time) from
// scripts/strom-layout.mjs, the "around the person" view is laid out here in the browser; drawing with d3.
import Base from '../layouts/Base.astro';
import strom from '../generated/strom.json';
import layout from '../generated/strom_layout.json';
const json = JSON.stringify({ ...strom, layout }).replace(/</g, '\\u003c');
// family lines (branches of the great-grandparents 8–15) for the filter, in the order of their founders
const rody = new Map<string, { color: string; k: number }>();
for (const n of Object.values(strom.nodes) as any[]) {
  if (!n.line) continue;
  const r = rody.get(n.line);
  if (!r || n.k < r.k) rody.set(n.line, { color: n.color, k: n.k });
}
const rodyList = [...rody.entries()].sort((a, b) => a[1].k - b[1].k);
---
<Base title="Rodinný strom" description="Celý rodinný strom: předci i boční příbuzní, u každého vše, co o něm víme" full>
  <!-- toolbar: left = what to show (view + its option), right = find a person and move around -->
  <div class="st2-bar">
    <div class="st2-bar-l">
      <strong>Rodinný strom</strong>
      <span class="st2-seg st2-modes" role="group" aria-label="Co zobrazit">
        <button type="button" data-mode="core" title="Přímí předci dětí">Předci</button>
        <button type="button" data-mode="focus" title="Vybraná osoba uprostřed: předci nad ní, sourozenci a partneři vedle, potomci pod ní">Kolem osoby</button>
        <button type="button" data-mode="full" title="Celý strom: předci i boční větve">Zobrazit vše</button>
      </span>
      <label class="st2-opt st2-rod">Rod
        <select id="st2-rod" aria-label="Zobrazit jen jeden rod">
          <option value="">všechny</option>
          {rodyList.map(([name]) => <option value={name}>{name}</option>)}
        </select>
      </label>
      <span class="st2-opt st2-depth" hidden>Generací
        <label title="Generací nahoru (předci)">↑ <select id="st2-up" aria-label="Generací nahoru">{[1, 2, 3, 4, 5, 6, 8, 10].map((v) => <option value={v} selected={v === 3}>{v}</option>)}</select></label>
        <label title="Generací dolů (potomci)">↓ <select id="st2-down" aria-label="Generací dolů">{[0, 1, 2, 3, 4].map((v) => <option value={v} selected={v === 2}>{v}</option>)}</select></label>
      </span>
    </div>
    <div class="st2-bar-r">
      <form class="strom-search" autocomplete="off" role="search">
        <input type="search" placeholder="Najít osobu…" aria-label="Najít osobu" aria-controls="st2-hits" />
        <button type="submit" aria-label="Najít">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M12.6 12.6 17 17"/></svg>
        </button>
        <div id="st2-hits" class="st2-hits" role="listbox" aria-label="Nalezené osoby" hidden></div>
      </form>
      <span class="st2-seg fan-btns" role="group" aria-label="Pohyb ve stromu">
        <button type="button" data-act="home" title="Zpět na výchozí osobu rodokmenu">Na začátek</button>
        <button type="button" data-act="fit" title="Oddálit tak, aby bylo vidět celé zobrazení">Celý pohled</button>
        <button type="button" data-act="out" aria-label="Oddálit" title="Oddálit">−</button>
        <button type="button" data-act="in" aria-label="Přiblížit" title="Přiblížit">+</button>
      </span>
    </div>
  </div>

  <div class="st2">
    <svg id="st2-svg" aria-label="Rodinný strom"></svg>
    <aside class="st2-panel" aria-live="polite"></aside>
    <p class="st2-hint small"><span id="st2-count"></span><span class="tip"> · táhnutím posunete, kolečkem přiblížíte, klepnutím vyberete</span></p>
    <div class="st2-mini" aria-hidden="true" title="Přehled celého stromu – klepnutím nebo tažením se přesunete"><svg></svg></div>
    <div class="st2-legend small">
      <span><i class="m"></i> muž</span><span><i class="f"></i> žena</span><span><i class="side"></i> boční příbuzný</span>
      <span><i class="dot"></i> barva rodu</span><span><b class="ok">✓</b> doloženo matrikou</span>
      <span><i class="path"></i> rodina vybrané osoby</span>
    </div>
  </div>

  <script type="application/json" id="strom-data" is:inline set:html={json} />

  <script>
    import { select } from 'd3-selection';
    import { zoom, zoomIdentity, type ZoomBehavior } from 'd3-zoom';
    import 'd3-transition';

    type Rec = { key: string; title: string; date: string };
    type Doc = { img: string; caption: string };
    type N = { id: string; name: string; years: string; sex: string; page: string | null; rel: string; status: string;
      st: string; color: string | null; facts: string[]; text: string; parents: string[]; spouses: string[];
      children: string[]; k: number | null; gen: number | null; line: string | null; photo: string | null; records: Rec[]; docs: Doc[] };
    type Fam = { id: string; parents: string[]; children: string[]; x: number | null; y: number | null };
    type L = { width: number; height: number; pos: Record<string, { x: number; y: number }>; fams: Fam[] };
    type LS = { card: { w: number; h: number }; root: string; full: L; core: L };
    const data = JSON.parse(document.getElementById('strom-data')!.textContent!) as { root: string; nodes: Record<string, N>; layout: LS };
    const { nodes, layout: LAY } = data;
    const W = LAY.card.w, H = LAY.card.h, SVGNS = 'http://www.w3.org/2000/svg';
    // three views (remembered per browser): "core" = direct line (precomputed), "full" = whole graph with side branches
    // (precomputed overview), "focus" = around the selected person, computed here and re-laid out on every selection
    type Mode = 'core' | 'full' | 'focus';
    let mode: Mode = 'core';
    let depthUp = 3, depthDown = 2;
    try {
      const m = localStorage.getItem('strom-mode');
      if (m === 'full' || m === 'focus') mode = m;
      depthUp = Number(localStorage.getItem('strom-up')) || 3;
      depthDown = Number(localStorage.getItem('strom-down') ?? 2);
      if (!Number.isFinite(depthDown)) depthDown = 2;
    } catch { /* storage blocked */ }
    let L: L = mode === 'focus' ? LAY.core : LAY[mode];   // focus layout is computed once the selection is known
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const label = (n: N) => (n.years ? `${n.name} (${n.years})` : n.name);
    const P = (id: string) => L.pos[id];
    // the starting person and their siblings are one family: drawn the same, not as side relatives
    const own = new Set([data.root, ...(nodes[data.root]?.parents ?? []).flatMap((p) => nodes[p]?.children ?? [])]);

    // --- text helpers -----------------------------------------------------------------------------------------------
    const fit = (s: string, max: number) => (s.length > max ? s.slice(0, max - 1).trimEnd() + '…' : s);
    function nameLines(name: string): string[] {
      if (name.length <= 21) return [name];
      const parts = name.split(' ');
      const last = parts.pop()!;
      return [fit(parts.join(' '), 23), fit(last, 23)];
    }
    function birthPlace(n: N): string {
      const f = n.facts.find((x) => x.startsWith('*'));
      if (!f) return '';
      return f.replace(/^\*\s*/, '').replace(/^(asi\s+)?[\d.\s–-]+/, '').split(/[(,;]/)[0].trim();
    }

    // --- drawing ----------------------------------------------------------------------------------------------------
    const svg = select<SVGSVGElement, unknown>('#st2-svg');
    const root = svg.append('g');
    const gLinks = root.append('g').attr('class', 'links');
    const gCards = root.append('g').attr('class', 'cards');
    const defs = svg.append('defs');
    defs.append('clipPath').attr('id', 'st2-av').append('circle').attr('cx', 34).attr('cy', H / 2).attr('r', 24);

    // silhouettes (public/siluety/) drawn as <image>
    const sil = (sex: string) => `/siluety/${sex === 'F' ? 'zena' : 'muz'}.svg`;
    const siblingsOf = (n: N) => [...new Set(n.parents.flatMap((p) => nodes[p]?.children ?? []))].filter((c) => c !== n.id);

    // --- "Kolem osoby": the selected person in the middle, ancestors above (father's side left, mother's right),
    // siblings to the left, partners to the right, descendants below. Tidy layout: every subtree gets its own width.
    const GAP = 26, CGAP = 18, ROW = H + 84;
    function focusLayout(fid: string, up: number, down: number): L {
      const pos: Record<string, { x: number; y: number }> = {};
      const fams: Fam[] = [];
      const at = (id: string, x: number, row: number) => { pos[id] = { x, y: row * ROW }; };
      // ancestors: returns the x of `id` and the right edge of its ancestor subtree
      function upTree(id: string, depth: number, left: number, row: number): { x: number; right: number } {
        const ps = depth > 0 ? nodes[id].parents.filter((p) => nodes[p] && !pos[p]) : [];
        if (!ps.length) return { x: left + W / 2, right: left + W + GAP };
        let r = left;
        const xs = ps.map((p) => { const t = upTree(p, depth - 1, r, row - 1); at(p, t.x, row - 1); r = t.right; return t.x; });
        fams.push({ id: `fu-${id}`, parents: ps, children: [id], x: ps.length === 2 ? (xs[0] + xs[1]) / 2 : null,
          y: ps.length === 2 ? (row - 1) * ROW : null });
        return { x: xs.length === 2 ? (xs[0] + xs[1]) / 2 : xs[0], right: Math.max(r, left + W + GAP) };
      }
      // descendants: a person with partners is one unit, children are laid out under it
      const partners = (id: string) => nodes[id].spouses.filter((s) => nodes[s]);
      const kidsOf = (id: string, depth: number) => (depth > 0 ? nodes[id].children.filter((c) => nodes[c]) : []);
      const unitW = (id: string) => (1 + partners(id).length) * W + partners(id).length * CGAP + GAP;
      const widthMemo = new Map<string, number>();
      function measure(id: string, depth: number): number {
        const k = `${id}|${depth}`;
        if (!widthMemo.has(k)) widthMemo.set(k, Math.max(unitW(id), kidsOf(id, depth).reduce((s, c) => s + measure(c, depth - 1), 0)));
        return widthMemo.get(k)!;
      }
      function downTree(id: string, depth: number, left: number, row: number) {
        const w = measure(id, depth), uw = unitW(id), sp = partners(id);
        let x = left + (w - uw) / 2 + W / 2;
        at(id, x, row);
        const sx = sp.map((s) => { x += W + CGAP; if (!pos[s]) at(s, x, row); return pos[s].x; });
        const kids = kidsOf(id, depth);
        let cl = left + (w - kids.reduce((s, c) => s + measure(c, depth - 1), 0)) / 2;
        for (const c of kids) { downTree(c, depth - 1, cl, row + 1); cl += measure(c, depth - 1); }
        // one family per partner (children who have that partner as the other parent), the rest with this parent only
        const rest = new Set(kids);
        sp.forEach((s, i) => {
          const ch = kids.filter((c) => nodes[c].parents.includes(s));
          ch.forEach((c) => rest.delete(c));
          fams.push({ id: `fd-${id}-${s}`, parents: [id, s], children: ch, x: (pos[id].x + sx[i]) / 2, y: row * ROW });
        });
        if (rest.size) fams.push({ id: `fd-${id}`, parents: [id], children: [...rest], x: null, y: null });
      }
      const top = upTree(fid, up, 0, 0);
      // descendants start so that fid lands exactly under the ancestors computed above
      downTree(fid, down, top.x - ((measure(fid, down) - unitW(fid)) / 2 + W / 2), 0);
      // siblings on the same row, to the left; they belong to the parents' family
      const sibs = siblingsOf(nodes[fid]).filter((s) => !pos[s]);
      const leftmost = Math.min(...Object.values(pos).filter((p) => p.y === 0).map((p) => p.x));
      sibs.forEach((s, i) => at(s, leftmost - (i + 1) * (W + GAP), 0));
      const pf = fams.find((f) => f.id === `fu-${fid}`);
      if (pf) pf.children.push(...sibs.filter((s) => nodes[s].parents.some((p) => pf.parents.includes(p))));
      // normalise to a 0-based drawing like the precomputed layouts (fitAll relies on it)
      const xs = Object.values(pos).map((p) => p.x), ys = Object.values(pos).map((p) => p.y);
      const ox = Math.min(...xs) - W / 2 - 40, oy = Math.min(...ys) - H / 2 - 40;
      for (const p of Object.values(pos)) { p.x -= ox; p.y -= oy; }
      for (const f of fams) if (f.x != null && f.y != null) { f.x -= ox; f.y -= oy; }
      return { width: Math.max(...xs) - ox + W / 2 + 40, height: Math.max(...ys) - oy + H / 2 + 40, pos, fams };
    }

    // relatives that the current view does not show (parents, partners, children, siblings) – the little tree icon
    const hiddenOf = (n: N) => [...new Set([...n.parents, ...n.spouses, ...n.children, ...siblingsOf(n)])]
      .filter((r) => nodes[r] && !P(r));

    // --- filter by family line ("rod" = branch of one of the great-grandparents 8–15, see LINES in osoby.py) ----------
    // members: the ancestors of that line, the direct line from them down to the starting person, and side relatives
    // reachable from the line's ancestors through other side relatives (siblings, their spouses and children…)
    let rod = '';
    const kOf: Record<number, string> = {};
    for (const n of Object.values(nodes)) if (n.page && n.k) kOf[n.k] = n.id;
    function rodMembers(line: string): Set<string> {
      const m = new Set<string>();
      const anc = Object.values(nodes).filter((n) => n.page && n.line === line);
      for (const a of anc) {
        m.add(a.id);
        for (let k = a.k ?? 1; k >= 1; k = Math.floor(k / 2)) if (kOf[k]) m.add(kOf[k]);   // down to the children
      }
      own.forEach((o) => m.add(o));
      const queue = anc.map((a) => a.id);
      while (queue.length) {
        const n = nodes[queue.shift()!];
        for (const r of [...n.parents, ...n.spouses, ...n.children, ...siblingsOf(n)]) {
          if (m.has(r) || !nodes[r] || nodes[r].page || own.has(r)) continue;
          m.add(r);
          queue.push(r);
        }
      }
      return m;
    }
    let inRod: Set<string> | null = null;
    const offRod = (id: string) => mode !== 'focus' && !!inRod && !inRod.has(id);

    let linkOf: Record<string, string[]> = {};                    // person id -> link ids touching it
    const addLink = (fid: string, d: string, people: string[]) => {
      const path = gLinks.append('path').attr('d', d).attr('data-f', fid);
      if (people.some(offRod)) path.classed('off', true);
      for (const p of people) (linkOf[p] ??= []).push(fid);
    };
    const cardEl = new Map<string, SVGGElement>();               // drawn cards, kept between redraws for the animation
    const tr = (p: { x: number; y: number }) => `translate(${p.x - W / 2},${p.y - H / 2})`;
    function draw(animate = false, origin?: { x: number; y: number }) {
    gLinks.selectAll('*').remove();
    linkOf = {};
    for (const f of L.fams) {
      const ps = f.parents.filter((p) => P(p));
      if (ps.length === 2 && f.x != null && f.y != null) {
        const [a, b] = ps.map(P).sort((u, v) => u.x - v.x);
        addLink(f.id, `M${a.x + W / 2},${a.y}H${b.x - W / 2}`, ps);
      }
      for (const c of f.children) {
        const cp = P(c);
        if (!cp) continue;
        const top = cp.y - H / 2, mid = top - 28;
        const d = ps.length === 2 && f.x != null
          ? `M${f.x},${f.y}V${mid}H${cp.x}V${top}`
          : `M${P(ps[0]).x},${P(ps[0]).y + H / 2}V${mid}H${cp.x}V${top}`;
        addLink(f.id, d, [...ps, c]);
      }
    }

    if (animate) gLinks.attr('opacity', 0).transition().delay(380).duration(300).attr('opacity', 1);
    else gLinks.attr('opacity', 1);

    const shown = new Set(Object.keys(L.pos));
    for (const [id, g] of cardEl) {                               // cards the new view does not have
      if (shown.has(id)) continue;
      cardEl.delete(id);
      if (animate) select(g).transition().duration(300).attr('opacity', 0).remove(); else g.remove();
    }
    for (const id of shown) {
      const n = nodes[id], p = P(id);
      if (!n) continue;
      let g = cardEl.get(id);
      const isNew = !g;
      if (!g) {
        g = document.createElementNS(SVGNS, 'g') as SVGGElement;
        g.setAttribute('data-id', id);
        g.setAttribute('tabindex', '0');
        gCards.node()!.appendChild(g);
        cardEl.set(id, g);
      }
      g.setAttribute('class', `card ${n.sex === 'F' ? 'f' : 'm'}${n.page || own.has(id) ? '' : ' side'}${offRod(id) ? ' off' : ''}`);
      g.innerHTML = cardInner(n);
      if (animate) {
        const s = select(g);
        if (isNew) s.attr('transform', tr(origin ?? p)).attr('opacity', 0);
        s.transition().duration(600).attr('transform', tr(p)).attr('opacity', 1);
      } else g.setAttribute('transform', tr(p)), g.setAttribute('opacity', '1');
    }
    const inView = inRod ? [...shown].filter((id) => inRod!.has(id)).length : shown.size;
    (document.getElementById('st2-count') as HTMLElement).textContent =
      `${inView} z ${Object.keys(nodes).length} osob${inRod ? ` · rod ${rod}` : ''}`;
    drawMini();
    }

    const silhouette = (sex: string) => `<circle cx="34" cy="${H / 2}" r="24" class="av-bg"/>
      <image href="${sil(sex)}" x="10" y="${H / 2 - 24}" width="48" height="48" clip-path="url(#st2-av)"/>`;
    // a tiny tree: three boxes joined like a family (the icon of "relatives not shown here")
    const treeIcon = `<path d="M-3.5 -4.5h7v3h-7z M-7 2.5h5v3h-5z M2 2.5h5v3h-5z M0 -1.5v2.5 M-4.5 1h9 M-4.5 1v1.5 M4.5 1v1.5"/>`;
    function cardInner(n: N): string {
      const hid = hiddenOf(n).length;
      const lines = nameLines(n.name);
      const place = lines.length === 1 ? birthPlace(n) : '';
      const ys = lines.length === 2 ? [19, 34, 51] : place ? [21, 38, 54] : [27, 45];
      const av = n.photo
        ? `<circle cx="34" cy="${H / 2}" r="24" class="av-bg"/><image href="/img/${encodeURIComponent(n.photo)}.jpg" x="10" y="${H / 2 - 24}" width="48" height="48" preserveAspectRatio="xMidYMin slice" clip-path="url(#st2-av)"/>`
        : silhouette(n.sex);
      return `<title>${esc(label(n))}${n.rel ? ' – ' + esc(n.rel) : ''}</title>
        <rect width="${W}" height="${H}" rx="10" class="bx"/>${av}
        ${n.color ? `<circle cx="${W - 11}" cy="11" r="4.5" fill="${esc(n.color)}"/>` : ''}
        ${n.st === 'doc' ? `<text x="${W - 11}" y="${H - 8}" class="ok" text-anchor="middle">✓</text>` : ''}
        ${hid ? `<g class="more" transform="translate(52,${H - 12})" role="button" aria-label="Další příbuzní (${hid}) – zobrazit kolem této osoby">
          <title>Další příbuzní, kteří tu nejsou vidět: ${hid} – klepněte pro zobrazení kolem této osoby</title>
          <circle r="9.5"/>${treeIcon}</g>` : ''}
        ${lines.map((l, i) => `<text x="66" y="${ys[i]}" class="nm">${esc(l)}</text>`).join('')}
        <text x="66" y="${ys[lines.length]}" class="yr">${esc(fit(n.years || ' ', 26))}</text>
        ${place ? `<text x="66" y="${ys[2]}" class="pl">${esc(fit(place, 24))}</text>` : ''}`;
    }

    // --- zoom -------------------------------------------------------------------------------------------------------
    const z: ZoomBehavior<SVGSVGElement, unknown> = zoom<SVGSVGElement, unknown>().scaleExtent([0.06, 2.2])
      .on('zoom', (e) => root.attr('transform', e.transform.toString()));
    svg.call(z).on('dblclick.zoom', null);
    const panelW = () => (window.innerWidth > 900 ? (document.querySelector('.st2-panel') as HTMLElement).offsetWidth + 16 : 0);
    const box = () => (svg.node() as SVGSVGElement).getBoundingClientRect();
    function centerOn(id: string, animate = true) {
      // the tree is for both children: "home" centres on the starting person together with the siblings
      const ps = (id === data.root ? [...own] : [id]).map(P).filter(Boolean);
      if (!ps.length) return;
      const x0 = Math.min(...ps.map((p) => p.x)), x1 = Math.max(...ps.map((p) => p.x)), y = ps[0].y;
      const r = box(), avail = r.width - panelW();
      const k = Math.min(Math.max(0.75, Math.min(1.1, currentK())), (avail - 24) / (x1 - x0 + W));   // all fit on narrow screens
      const t = zoomIdentity.translate(panelW() + avail / 2 - ((x0 + x1) / 2) * k, r.height / 2 - y * k).scale(k);
      (animate ? svg.transition().duration(650) : svg).call(z.transform as any, t);
    }
    let kNow = 1;
    const currentK = () => kNow;
    z.on('zoom.k', (e) => { kNow = e.transform.k; });
    // fit a part of the drawing (default the whole view, or the chosen family line) into the free area
    function fitAll() {
      // the line itself (not the bridge down to the children, which may sit far away in the overview)
      const ids = inRod && mode !== 'focus' ? [...inRod].filter((id) => P(id) && !own.has(id) && !((nodes[id].k ?? 99) < 8)) : [];
      const ps = ids.map(P);
      const [x0, y0, x1, y1] = ps.length
        ? [Math.min(...ps.map((p) => p.x)) - W / 2 - 30, Math.min(...ps.map((p) => p.y)) - H / 2 - 30,
           Math.max(...ps.map((p) => p.x)) + W / 2 + 30, Math.max(...ps.map((p) => p.y)) + H / 2 + 30]
        : [0, 0, L.width, L.height];
      const r = box(), pw = panelW(), bw = x1 - x0, bh = y1 - y0;
      const k = Math.min((r.width - pw - 40) / bw, (r.height - 40) / bh, 1);
      svg.transition().duration(650).call(z.transform as any,
        zoomIdentity.translate(pw + (r.width - pw - bw * k) / 2 - x0 * k, (r.height - bh * k) / 2 - y0 * k).scale(k));
    }

    // --- minimap (overview of the big views): all cards as dots, the visible part as a frame; click or drag to move --
    const miniBox = document.querySelector('.st2-mini') as HTMLElement;
    const miniSvg = miniBox.querySelector('svg') as SVGSVGElement;
    let tNow = zoomIdentity;
    z.on('zoom.mini', (e) => { tNow = e.transform; updateMini(); });
    function drawMini() {
      miniBox.hidden = mode === 'focus' || window.innerWidth <= 900;
      if (miniBox.hidden) return;
