    upSel.addEventListener('change', onDepth);
    downSel.addEventListener('change', onDepth);
    // --- search: list of matches (name and years, without diacritics); ancestors first ------------------------------
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const people = Object.values(nodes).map((n) => ({ n, key: norm(`${n.name} ${n.years || ''}`) }));
    const form = document.querySelector<HTMLFormElement>('.strom-search')!;
    const input = form.querySelector('input')!;
