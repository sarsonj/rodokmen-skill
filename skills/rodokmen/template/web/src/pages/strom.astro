      hits.innerHTML = list.slice(0, 15).map((n) => `<button type="button" role="option" data-hit="${esc(n.id)}" class="${n.sex === 'F' ? 'f' : 'm'}">
        <b>${esc(n.name)}</b> <span>${esc(n.years || '')}</span>
        <small>${esc(n.rel || (n.page || own.has(n.id) ? '' : 'boční příbuzný'))}</small></button>`).join('')
