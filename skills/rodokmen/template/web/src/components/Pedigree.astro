---
// Four columns: the person, parents, grandparents, great-grandparents (Kekulé arithmetic on the root-relative number).
// Boxes in the last column show how many more known generations continue behind them.
import { byK, href } from '../lib/data.js';
const { k } = Astro.props;
const canon = (kk) => byK[kk]?.k ?? kk;
const cols = [[k]];
for (let d = 1; d < 4; d++) cols.push(cols[d - 1].flatMap((kk) => [2 * canon(kk), 2 * canon(kk) + 1]));
cols.forEach((col, d) => (cols[d] = col.map((kk, i) => ({ k: kk, span: 8 / 2 ** d, row: 1 + i * (8 / 2 ** d) }))));
const depth = (kk) => ((kk = canon(kk)), byK[2 * kk] || byK[2 * kk + 1] ? 1 + Math.max(depth(2 * kk), depth(2 * kk + 1)) : 0);
const known = (kk) => (byK[kk] ? 1 + known(2 * canon(kk)) + known(2 * canon(kk) + 1) : 0);
const genWord = (n) => (n === 1 ? 'generace' : n < 5 ? 'generace' : 'generací');
---
<div class="pedigree" role="list" aria-label="Rodokmen tři generace nazpět">
  {cols.map((col, c) =>
    col.map(({ k: kk, span, row }) => {
      const p = byK[kk];
      const style = `grid-column:${c + 1};grid-row:${row} / span ${span}`;
      const more = c === 3 && p ? depth(kk) : 0;
      return p ? (
        <a role="listitem" class={`box ${c === 0 ? 'self' : ''} ${more ? 'has-more' : ''}`} style={style} href={href.person(p.slug)}
          title={more ? `Rodokmen pokračuje: ${known(kk) - 1} dalších předků` : undefined}>
          {p.name}<span class="y">{p.years || ' '}</span>
          {more > 0 && <span class="more">a dál {more} {genWord(more)} →</span>}
        </a>
      ) : (
        <span role="listitem" class="box empty" style={style}>?</span>
      );
    })
  )}
</div>
